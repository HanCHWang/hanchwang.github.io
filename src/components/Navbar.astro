---
const links = [
  { href: "/", label: "About" },
  { href: "/publications", label: "Publications" },
  { href: "/research", label: "Research" },
  { href: "/supervision", label: "Supervision" },
  { href: "/misc", label: "Misc" },
];
---

<header class="site-header">
  <nav class="nav" aria-label="Primary navigation">
    <div class="nav-identity">
      <a class="eth-logo" href="https://ethz.ch/" target="_blank" rel="noreferrer" aria-label="ETH Zürich">
        <img
          src="https://upload.wikimedia.org/wikipedia/commons/9/99/ETH_Z%C3%BCrich_Logo_black.svg"
          alt="ETH Zürich"
        />
      </a>
      <a class="nav-avatar" href="/" aria-label="Han Wang home">
        <img src="/profile.jpg" alt="Portrait of Han Wang" />
      </a>
      <a href="/" class="brand">
        <span>Han Wang</span>
        <span class="brand-cn">王汉</span>
      </a>
    </div>

    <div class="nav-right">
      <button
        id="nav-menu-toggle"
        class="nav-menu-toggle"
        aria-label="Open navigation menu"
        aria-controls="primary-nav-links"
        aria-expanded="false"
        type="button"
      >
        <span class="nav-menu-bars" aria-hidden="true"></span>
      </button>

      <div id="primary-nav-links" class="nav-links">
        {links.map((link) => (
          <a href={link.href} class="nav-link">{link.label}</a>
        ))}
      </div>

      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" type="button">
        <span class="theme-option theme-option-light" aria-hidden="true">☀</span>
        <span class="theme-option theme-option-dark" aria-hidden="true">☾</span>
      </button>
    </div>

    <aside class="snow-countdown" aria-label="Swiss snow season countdown">
      <img src="/swiss-snow-season.svg" alt="Swiss snow season" />
      <div class="snow-countdown-copy">
        <span class="snow-countdown-label">Swiss snow season</span>
        <span class="snow-countdown-time">
          <strong id="snow-countdown-days">--</strong>
          <span id="snow-countdown-unit">days</span>
        </span>
      </div>
    </aside>
  </nav>
</header>

<script is:inline>
  const button = document.getElementById("theme-toggle");
  const menuButton = document.getElementById("nav-menu-toggle");
  const nav = document.querySelector(".nav");
  const navLinks = document.getElementById("primary-nav-links");
  const root = document.documentElement;

  function updateIcon(theme) {
    button?.setAttribute("data-theme-state", theme);
    button?.setAttribute(
      "aria-label",
      theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
    );
  }

  function applyTheme(theme) {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    localStorage.setItem("theme", theme);
    updateIcon(theme);
  }

  const currentTheme = root.dataset.theme || localStorage.getItem("theme") || "light";
  root.dataset.theme = currentTheme;
  root.style.colorScheme = currentTheme;
  updateIcon(currentTheme);

  button?.addEventListener("click", () => {
    const current = root.dataset.theme || "light";
    const next = current === "dark" ? "light" : "dark";
    applyTheme(next);
  });

  function setMenuOpen(isOpen) {
    nav?.setAttribute("data-menu-open", String(isOpen));
    menuButton?.setAttribute("aria-expanded", String(isOpen));
    menuButton?.setAttribute("aria-label", isOpen ? "Close navigation menu" : "Open navigation menu");
  }

  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    setMenuOpen(!isOpen);
  });

  navLinks?.addEventListener("click", (event) => {
    if (event.target instanceof HTMLAnchorElement) {
      setMenuOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });

  document.addEventListener("click", (event) => {
    if (!nav?.contains(event.target)) setMenuOpen(false);
  });

  window.addEventListener("resize", () => {
    if (window.matchMedia("(min-width: 769px)").matches) setMenuOpen(false);
  });

  const countdownDays = document.getElementById("snow-countdown-days");
  const countdownUnit = document.getElementById("snow-countdown-unit");

  function updateSnowCountdown() {
    if (!countdownDays || !countdownUnit) return;

    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const currentYearStart = new Date(today.getFullYear(), 11, 1);
    const target =
      today <= currentYearStart ? currentYearStart : new Date(today.getFullYear() + 1, 11, 1);
    const msPerDay = 24 * 60 * 60 * 1000;
    const days = Math.round((target.getTime() - today.getTime()) / msPerDay);

    countdownDays.textContent = String(days);
    countdownUnit.textContent = days === 1 ? "day" : "days";
  }

  updateSnowCountdown();
  window.setInterval(updateSnowCountdown, 60 * 60 * 1000);
</script>
