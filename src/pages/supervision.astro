---
import MainLayout from "../layouts/MainLayout.astro";
import supervision from "../data/supervision.json";

const projects = supervision.groups.flatMap((group) => group.items);
const masterCount = projects.filter((item) => item.role.includes("Master")).length;
const visitingCount = projects.filter((item) => item.role.includes("Visiting")).length;

const institutionLogos = {
  "At ETH Zürich": {
    src: "https://upload.wikimedia.org/wikipedia/commons/9/99/ETH_Z%C3%BCrich_Logo_black.svg",
    alt: "ETH Zürich logo",
  },
  "At University of Oxford": {
    src: "https://commons.wikimedia.org/wiki/Special:Redirect/file/University_of_Oxford.svg",
    alt: "University of Oxford logo",
  },
};
---

<MainLayout title="Supervision | Han Wang">
  <section class="page-intro">
    <h1>Supervision</h1>
    <p class="intro">
      I supervise master theses in safe learning, adaptive control, optimization
      and autonomy applications.
    </p>
  </section>

  <section class="supervision-overview" aria-label="Supervision overview">
    <div>
      <span class="overview-number">{projects.length}</span>
      <span class="overview-label">current and recent projects</span>
    </div>
    <div>
      <span class="overview-number">{masterCount}</span>
      <span class="overview-label">master students</span>
    </div>
    <div>
      <span class="overview-number">{visitingCount}</span>
      <span class="overview-label">visiting Ph.D. student</span>
    </div>
  </section>

  <div class="supervision-list">
    {supervision.groups.map((group) => (
      <section class="supervision-section" aria-labelledby={`supervision-${group.label.toLowerCase().replaceAll(" ", "-")}`}>
        <div class="supervision-section-head">
          {institutionLogos[group.label] && (
            <img
              class="supervision-institution-logo"
              src={institutionLogos[group.label].src}
              alt={institutionLogos[group.label].alt}
            />
          )}
          <h2 id={`supervision-${group.label.toLowerCase().replaceAll(" ", "-")}`}>{group.label}</h2>
        </div>

        <ol>
          {group.items.map((item) => (
            <li class="supervision-item">
              <article>
                <div class="supervision-meta">
                  <span class="supervision-role">{item.role}</span>
                  {item.period && <time>{item.period}</time>}
                </div>

                <div class="supervision-body">
                  <h3>{item.name}</h3>
                  <p class="supervision-project">{item.project}</p>

                  {item.with && item.with.length > 0 && (
                    <p class="supervision-with">Co-supervised with {item.with.join(", ")}</p>
                  )}

                  {item.outcome && <p class="supervision-outcome">{item.outcome}</p>}
                </div>
              </article>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</MainLayout>
