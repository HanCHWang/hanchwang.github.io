---
import MainLayout from "../../layouts/MainLayout.astro";

const description =
  "Personal notes from Han Wang on names, research, places, and the small stories behind the work.";
const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blog by Han Wang",
  description,
  url: "https://hanchwang.github.io/blog/",
  author: {
    "@type": "Person",
    name: "Han Wang",
  },
  blogPost: {
    "@type": "BlogPosting",
    headline: "Why I Use “HanCHWang” Everywhere",
    datePublished: "2026-08-12",
    url: "https://hanchwang.github.io/blog/why-hanchwang/",
  },
};
---

<MainLayout
  title="Blog | Han Wang"
  description={description}
  canonicalPath="/blog/"
  jsonLd={blogJsonLd}
>
  <section class="page-intro blog-intro">
    <h1>Blog</h1>
  </section>

  <section class="blog-list" aria-label="Blog posts">
    <article class="blog-card">
      <time datetime="2026-08-12">August 12, 2026</time>
      <h2><a href="/blog/why-hanchwang/">Why I Use “HanCHWang” Everywhere</a></h2>
      <p>
        The story behind the “CH” in <em>hanchwang</em>—and why it is neither a reference to
        Switzerland nor an arbitrary username.
      </p>
      <a class="blog-card-link" href="/blog/why-hanchwang/" aria-label="Read Why I Use HanCHWang Everywhere">
        Read essay <span aria-hidden="true">→</span>
      </a>
    </article>
  </section>
</MainLayout>
