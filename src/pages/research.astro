---
import MainLayout from "../layouts/MainLayout.astro";
import researchPillars from "../data/research-pillars.json";
---

<MainLayout title="Research | Han Wang">
  <section class="page-intro">
    <h1>Research</h1>
    <p class="intro">
      My research is organized around three connected pillars: making control
      systems safe, making learning certifiable, and making autonomy work in
      practical engineering environments.
    </p>
  </section>

  <section class="research-pillar-grid" aria-label="Research pillars">
    {researchPillars.items.map((pillar, index) => (
      <article id={pillar.id} class="research-pillar-card">
        <a
          class="research-pillar-media"
          href={`/research/${pillar.slug}`}
          aria-label={`Read more about ${pillar.title}`}
        >
          {pillar.media?.type === "video" ? (
            <video
              src={pillar.media.src}
              poster={pillar.media.poster}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            ></video>
          ) : pillar.media?.src ? (
            <img src={pillar.media.src} alt="" />
          ) : (
            <span>Image pending</span>
          )}
        </a>
        <p class="pillar-index">{String(index + 1).padStart(2, "0")}</p>
        <h2>
          <a href={`/research/${pillar.slug}`}>{pillar.title}</a>
        </h2>
        <p>{pillar.summary}</p>
      </article>
    ))}
  </section>
</MainLayout>
