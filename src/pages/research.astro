---
import MainLayout from "../layouts/MainLayout.astro";
import researchPillars from "../data/research-pillars.json";

const description =
  "Research by Han Wang on safe control, certified learning, control barrier functions, predictive control, robotics, and practical autonomy.";
const researchJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Research by Han Wang",
  description,
  url: "https://hanchwang.github.io/research/",
  hasPart: researchPillars.items.map((pillar) => ({
    "@type": "CreativeWork",
    name: pillar.title,
    description: pillar.summary,
    url: `https://hanchwang.github.io/research/${pillar.slug}/`,
    keywords: pillar.topics,
  })),
};
---

<MainLayout title="Research | Han Wang" description={description} canonicalPath="/research/" jsonLd={researchJsonLd}>
  <section class="page-intro">
    <h1>Research</h1>
    <p class="intro">
      My research is organized around three connected pillars: making control
      systems safe, making learning certifiable, and making autonomy work in
      practical engineering environments.
    </p>
  </section>

  <section class="research-pillar-grid" aria-label="Research pillars">
    {researchPillars.items.map((pillar, index) => (
      <article id={pillar.id} class="research-pillar-card">
        <a
          class="research-pillar-media"
          href={`/research/${pillar.slug}`}
          aria-label={`Read more about ${pillar.title}`}
        >
          {pillar.media?.type === "video" ? (
            <video
              src={pillar.media.src}
              poster={pillar.media.poster}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            ></video>
          ) : pillar.media?.src ? (
            <img src={pillar.media.src} alt="" />
          ) : (
            <span>Image pending</span>
          )}
        </a>
        <p class="pillar-index">{String(index + 1).padStart(2, "0")}</p>
        <h2>
          <a href={`/research/${pillar.slug}`}>{pillar.title}</a>
        </h2>
        <p>{pillar.summary}</p>
      </article>
    ))}
  </section>
</MainLayout>
