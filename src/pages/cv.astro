---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CV | Han Wang" description="Curriculum vitae of Han Wang">
  <main class="container">
    <section class="hero">
      <h1>Han Wang</h1>
      <p>Postdoctoral Researcher at ETH Zürich · Control, learning, and safety for autonomous systems</p>
      <div class="links">
        <a href="/cv.pdf" target="_blank" rel="noopener">Download PDF</a>
        <a href="https://scholar.google.com/citations?user=M7i0_74AAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a>
        <a href="https://hanchwang.github.io/" target="_blank" rel="noopener">Personal Website</a>
      </div>
    </section>

    <section class="pdf-card">
      <h2>Curriculum Vitae</h2>
      <p>The latest CV is available below.</p>
      <iframe src="/cv.pdf" title="Han Wang CV"></iframe>
    </section>
  </main>
</BaseLayout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
  }
  .hero {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    margin: 0 0 0.4rem;
    font-size: 2rem;
  }
  .hero p {
    margin: 0;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .links a {
    display: inline-block;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
  }
  .pdf-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.25rem;
  }
  iframe {
    width: 100%;
    height: 900px;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    margin-top: 0.75rem;
    background: white;
  }
  @media (max-width: 800px) {
    iframe { height: 700px; }
  }
</style>
